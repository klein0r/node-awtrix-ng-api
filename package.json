{
  "name": "awtrix-ng-api",
  "version": "0.1.0",
  "description": "Type-safe HTTP API client for AWTRIX NG LED matrix clocks (Node.js, TypeScript, axios)",
  "keywords": [
    "awtrix",
    "awtrix-ng",
    "awtrix3",
    "ulanzi",
    "led-matrix",
    "iobroker",
    "api-client",
    "typescript"
  ],
  "license": "MIT",
  "author": "Matthias Kleine",
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/write-module-types.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
